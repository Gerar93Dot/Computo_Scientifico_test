{
  "name": "buruburu-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "server": "tsx server/index.ts",
    "build": "npm run assets && tsc --noEmit && vite build && node scripts/service-worker.mjs",
    "start": "NODE_ENV=production tsx server/index.ts",
    "assets": "node scripts/assets.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "build:pages": "VITE_LOCAL_ONLY=true VITE_BASE_PATH=/Computo_Scientifico_test/ npm run build"
  },
  "dependencies": {
    "express": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tesseract.js": "^6.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/spa": "^1.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  }
}
